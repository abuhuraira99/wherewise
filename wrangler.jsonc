{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wherewise",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Live sample feeds are stored here and refreshed on a schedule, so visitors
  // never wait on (or break because of) a slow public API.
  "kv_namespaces": [{ "binding": "FEEDS", "id": "8cab6cd97ad34ee58fcc1f989198e0c4" }],
  "triggers": {
    // every 15 minutes: earthquakes; the crash feed refreshes itself every 3 hours inside the handler
    "crons": ["*/15 * * * *"]
  },
  "observability": { "enabled": true }
}
